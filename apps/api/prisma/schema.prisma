generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  APPROVER
  ADMIN
}

enum CommunicationStatus {
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum DecisionType {
  APPROVED
  REJECTED
}

enum FlowEventType {
  SUBMITTED
  IN_REVIEW
  DECISION
  CANCELLED
  EDITED
  DECISION_REVERTED
}

// ---------------------------------------------------------------- core

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  role         Role      @default(MEMBER)
  active       Boolean   @default(true)
  passwordHash String?   @map("password_hash")
  invitedAt    DateTime? @map("invited_at")
  projectId    String?   @map("project_id")
  project      Project?  @relation("ProjectMembers", fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  passwordSetupTokens   PasswordSetupToken[]
  defaultApproverOf     Project[]        @relation("ProjectDefaultApprover")
  globalDefaultApprover DefaultApprover?
  authored              Communication[]  @relation("CommunicationAuthor")
  covering              Communication[]  @relation("CommunicationCover")
  approving             Communication[]  @relation("CommunicationApprover")
  decisions             Decision[]
  flowEvents            FlowEvent[]
  approvalBatches       ApprovalBatch[]

  @@index([projectId])
  @@index([active, role])
  @@map("users")
}

model Session {
  id         String   @id
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordSetupToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_setup_tokens")
}

model Project {
  id                String   @id @default(uuid())
  name              String   @unique
  active            Boolean  @default(true)
  defaultApproverId String?  @map("default_approver_id")
  defaultApprover   User?    @relation("ProjectDefaultApprover", fields: [defaultApproverId], references: [id], onDelete: SetNull)
  members           User[]   @relation("ProjectMembers")
  communications    Communication[]
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

// ------------------------------------------------------ disponibilidade

model AvailabilitySettings {
  id                        Int      @id @default(1)
  minNoticeDays             Int      @default(7) @map("min_notice_days")
  maxSimultaneousPerProject Int      @default(2) @map("max_simultaneous_per_project")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  defaultApprovers          DefaultApprover[]

  @@map("availability_settings")
}

model DefaultApprover {
  settingsId Int                  @default(1) @map("settings_id")
  settings   AvailabilitySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  userId     String               @unique @map("user_id")
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Int

  @@id([settingsId, userId])
  @@map("availability_default_approvers")
}

model CommunicationCounter {
  year         Int @id
  lastSequence Int @default(0) @map("last_sequence")

  @@map("communication_counters")
}

model Communication {
  id           String              @id @default(uuid())
  code         String              @unique
  year         Int
  sequence     Int
  authorId     String              @map("author_id")
  author       User                @relation("CommunicationAuthor", fields: [authorId], references: [id])
  projectId    String              @map("project_id")
  project      Project             @relation(fields: [projectId], references: [id])
  startDate    DateTime            @db.Date @map("start_date")
  endDate      DateTime            @db.Date @map("end_date")
  businessDays Int                 @map("business_days")
  coverId      String              @map("cover_id")
  cover        User                @relation("CommunicationCover", fields: [coverId], references: [id])
  approverId   String              @map("approver_id")
  approver     User                @relation("CommunicationApprover", fields: [approverId], references: [id])
  notes        String?
  status       CommunicationStatus @default(IN_REVIEW)
  submittedAt  DateTime            @map("submitted_at")
  cancelledAt  DateTime?           @map("cancelled_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  decisions Decision[]
  events    FlowEvent[]

  @@unique([year, sequence])
  @@index([authorId, submittedAt(sort: Desc)])
  @@index([approverId, status, submittedAt])
  @@index([projectId, status, startDate, endDate])
  @@index([status, startDate, endDate])
  @@map("communications")
}

model ApprovalBatch {
  id            String     @id @default(uuid())
  approverId    String     @map("approver_id")
  approver      User       @relation(fields: [approverId], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")
  undoableUntil DateTime   @map("undoable_until")
  undoneAt      DateTime?  @map("undone_at")
  decisions     Decision[]

  @@map("approval_batches")
}

model Decision {
  id              String         @id @default(uuid())
  communicationId String         @map("communication_id")
  communication   Communication  @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  type            DecisionType
  deciderId       String         @map("decider_id")
  decider         User           @relation(fields: [deciderId], references: [id])
  decidedAt       DateTime       @default(now()) @map("decided_at")
  justification   String?
  batchId         String?        @map("batch_id")
  batch           ApprovalBatch? @relation(fields: [batchId], references: [id])
  revertedAt      DateTime?      @map("reverted_at")

  @@index([communicationId, decidedAt(sort: Desc)])
  @@index([batchId])
  @@map("decisions")
}

model FlowEvent {
  id              String        @id @default(uuid())
  communicationId String        @map("communication_id")
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  type            FlowEventType
  actorId         String?       @map("actor_id")
  actor           User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt      DateTime      @default(now()) @map("occurred_at")
  description     String
  metadata        Json?

  @@index([communicationId, occurredAt])
  @@map("flow_events")
}
