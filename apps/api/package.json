{
  "name": "@nacif/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "types": "wrangler types",
    "migrate": "wrangler d1 migrations apply nacif-interno --local",
    "migrate:new": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nacif/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.156.0"
  }
}
