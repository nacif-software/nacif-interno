# Variáveis do `wrangler dev` (copie para `.dev.vars`, que não é versionado).
APP_ENV=development
APP_URL=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=debug
# Web Push (ADR 0013): o `make install` acrescenta aqui um par VAPID só deste computador.
# Para gerar outro: `cd apps/api && pnpm --silent vapid-keys mailto:dev@nacif.xyz >> .dev.vars`.
# Nenhuma chave privada é versionada; sem as três variáveis o push fica desligado e o app segue igual.
