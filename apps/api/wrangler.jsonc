{
  // Configuração do Worker único: API em /api/* + SPA do web pelos Static Assets (ADR 0011).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nacif-interno",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-29",
  // Só o Custom Domain abaixo recebe tráfego: sem URL nacif-interno.<conta>.workers.dev pública.
  "workers_dev": false,
  // Criado pelo primeiro `wrangler deploy` (issue #16): registro DNS `interno` + certificado na zona
  // nacif.software. Só esse hostname, nunca curinga: a raiz e o `www` da zona são o site da empresa.
  // Precauções e passo a passo em docs/deploy.md.
  "routes": [{ "pattern": "interno.nacif.software", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nacif-interno-prod",
      // Banco de produção criado em 2026-10-30 (issue #16, região ENAM). O dev local ignora o id.
      // Migrações: `wrangler d1 migrations apply nacif-interno-prod --remote` (o Builds faz no deploy).
      "database_id": "83f41649-33c2-48b3-b7c0-c563fef31567",
      "migrations_dir": "drizzle",
    },
  ],
  // Valores de produção (o deploy sobrescreve o que estiver no painel). Em dev, `.dev.vars`
  // (copiado de `.dev.vars.example`) sobrescreve. Segredos nunca aqui: `wrangler secret put`.
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://interno.nacif.software",
    "COOKIE_SECURE": "true",
    "SESSION_TTL_DAYS": "30",
    "LOG_LEVEL": "info",
    // Web Push (ADR 0013): a chave pública não é segredo; a privada entra por `wrangler secret put VAPID_PRIVATE_KEY`.
    "VAPID_PUBLIC_KEY": "BFt8xesOTLponXyXtoVrHox5Dj1ZrQo6PrJ1oIFrdMl8l9PuCoEmwAbA0rVJHfUVqau9mY2DtJQe1CnVYxbHWxM",
    "VAPID_SUBJECT": "mailto:wenderson@nacif.xyz",
  },
  "triggers": {
    // Diário às 03:00 UTC (00:00 em São Paulo): limpeza de sessões e tokens expirados e crédito anual de dias.
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
