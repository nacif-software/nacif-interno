# Portas expostas no host pelo docker compose (mude se houver conflito)
DB_PORT=5434
DB_TEST_PORT=5433
API_PORT=3010
WEB_PORT=5173

# Postgres (docker compose)
POSTGRES_USER=nacif
POSTGRES_PASSWORD=nacif
POSTGRES_DB=nacif

# API
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
TZ=America/Sao_Paulo
DATABASE_URL=postgresql://nacif:nacif@db:5432/nacif
# usado por `make test-api` e por comandos prisma no host (fora do Docker)
TEST_DATABASE_URL=postgresql://nacif:nacif@localhost:5433/nacif_test
HOST_DATABASE_URL=postgresql://nacif:nacif@localhost:5434/nacif
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
APP_URL=http://localhost:5173
SEED_PASSWORD=nacif1234

# Web (Vite)
VITE_API_PROXY_TARGET=http://api:3000
